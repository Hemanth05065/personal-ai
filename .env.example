ASSISTANT_APP_NAME=Local AI Personal Assistant
ASSISTANT_ENVIRONMENT=development
ASSISTANT_DATABASE_URL=sqlite:///./assistant.db
ASSISTANT_OLLAMA_URL=http://127.0.0.1:11434
ASSISTANT_MODEL=qwen3.5:4b
ASSISTANT_ALLOWED_ORIGINS=http://localhost:5173
ASSISTANT_MAX_CONTEXT_MESSAGES=20
ASSISTANT_WORKSPACE_DIR=assistant_workspace
ASSISTANT_MAX_FILE_BYTES=1000000
# Optional for access beyond localhost. Leave blank for local-only development.
ASSISTANT_API_KEY=
ASSISTANT_AUTH_REQUIRED=true
ASSISTANT_SESSION_HOURS=12
ASSISTANT_SECURE_COOKIES=false
ASSISTANT_SECURITY_DIR=.security
# Set a long random value in production, or leave blank to use a protected local key file.
ASSISTANT_MASTER_KEY=
ASSISTANT_OPA_URL=http://127.0.0.1:8181
ASSISTANT_OPA_REQUIRED=false
ASSISTANT_OPENSHELL_ENABLED=false
VITE_API_URL=http://localhost:8000
VITE_API_KEY=
